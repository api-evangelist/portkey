        {
          "id": "e43d36c0-965d-49b3-b44b-1d144ce544d0",
          "name": "Upload a file to be used across various endpoints, such as Assistant (<2M tokens), Fine-Tuning, and Batch (<100 MB). Total size of your bucket is 100 GB.\n",
          "request": {
            "name": "Upload a file to be used across various endpoints, such as Assistant (<2M tokens), Fine-Tuning, and Batch (<100 MB). Total size of your bucket is 100 GB.\n",
            "description": {},
            "url": {
              "path": [
                "files"
              ],
              "host": [
                "{{files-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-portkey-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The File object (not file name) to be uploaded.\n"
                },
                {
                  "key": "purpose",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The intended purpose of the uploaded file.\n\nUse \"assistants\" for [Assistants](https://platform.openai.com/docs/api-reference/assistants) and [Message](https://platform.openai.com/docs/api-reference/messages) files, \"vision\" for Assistants image file inputs, \"batch\" for [Batch API](https://platform.openai.com/docs/guides/batch), and \"fine-tune\" for [Fine-tuning](https://platform.openai.com/docs/api-reference/fine-tuning).\n (This can only be one of assistants,batch,fine-tune,vision)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "ebed14af-dfbe-47d6-a64c-b945f6f27035",
              "name": "OK",
              "originalRequest": {
                "url": {
                  "path": [
                    "files"
                  ],
                  "host": [
                    "{{files-Url}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-portkey-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) The File object (not file name) to be uploaded.\n",
                        "type": "text/plain"
                      },
                      "key": "file",
                      "value": "<binary>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required) The intended purpose of the uploaded file.\n\nUse \"assistants\" for [Assistants](https://platform.openai.com/docs/api-reference/assistants) and [Message](https://platform.openai.com/docs/api-reference/messages) files, \"vision\" for Assistants image file inputs, \"batch\" for [Batch API](https://platform.openai.com/docs/guides/batch), and \"fine-tune\" for [Fine-tuning](https://platform.openai.com/docs/api-reference/fine-tuning).\n (This can only be one of assistants,batch,fine-tune,vision)",
                        "type": "text/plain"
                      },
                      "key": "purpose",
                      "value": "<string>",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
