{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portkey Analytics > Graphs Logs Export API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-portkey-api-key",
      "value": "{{x-portkey-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs Export",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific logs export",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portkey.ai/v1/logs/exports/:exportId",
            "params": [
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific logs export"
        },
        {
          "info": {
            "name": "Update a logs export",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.portkey.ai/v1/logs/exports/:exportId",
            "params": [
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a logs export"
        },
        {
          "info": {
            "name": "Get all logs exports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portkey.ai/v1/logs/exports",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all logs exports"
        },
        {
          "info": {
            "name": "Create log export",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.portkey.ai/v1/logs/exports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create log export"
        },
        {
          "info": {
            "name": "Start log export",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.portkey.ai/v1/logs/exports/:exportId/start",
            "params": [
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Start log export"
        },
        {
          "info": {
            "name": "Cancel log export",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.portkey.ai/v1/logs/exports/:exportId/cancel",
            "params": [
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel log export"
        },
        {
          "info": {
            "name": "Download log export",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portkey.ai/v1/logs/exports/:exportId/download",
            "params": [
              {
                "name": "exportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download log export"
        }
      ]
    }
  ],
  "bundled": true
}