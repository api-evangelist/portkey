              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search query to filter labels by name"
              },
              {
                "name": "current_page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "page_size",
                "value": "",
