{
  "opencollection": "1.0.0",
  "info": {
    "name": "Portkey Analytics > Graphs Logs API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-portkey-api-key",
      "value": "{{x-portkey-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Insert New logs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.portkey.ai/v1/logs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit one or more log entries"
        },
        {
          "info": {
            "name": "Get a specific log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portkey.ai/v1/logs/:logId",
            "params": [
              {
                "name": "logId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific log"
        }
      ]
    }
  ],
  "bundled": true
}